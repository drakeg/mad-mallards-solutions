MMS_PORT=8099
# Local Python defaults to 127.0.0.1; Docker uses 0.0.0.0 for container access.

# Optional: enable encrypted contact inquiry notifications.
# Keep real credentials in your ignored .env file; never commit them.
# MMS_SMTP_HOST=smtp.example.com
# MMS_SMTP_PORT=587
# MMS_SMTP_SSL=false
# MMS_SMTP_USERNAME=
# MMS_SMTP_PASSWORD=
# MMS_SMTP_FROM=notifications@example.com
# MMS_CONTACT_TO=owner@example.com
